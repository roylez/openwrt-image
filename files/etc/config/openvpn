
config openvpn 'Canonical'
	option nobind '1'
	option float '1'
	option client '1'
	option comp_lzo 'yes'
	option reneg_sec '0'
	option dev 'tun'
	option verb '3'
	option persist_tun '1'
	option persist_key '1'
	option remote_cert_tls 'server'
	option ca '/etc/openvpn/canonical_ca.crt'
	option cert '/etc/openvpn/canonical-roylez.crt'
	option key '/etc/openvpn/canonical-roylez.key'
	option tls_auth '/etc/openvpn/canonical_ta.key 1'
	option data_ciphers 'AES-256-GCM:AES-128-GCM:AES-128-CBC'
	option enabled '1'
	list pull_filter 'ignore "route-ipv6 2620:2d"'
	list pull_filter 'ignore "route 185.125.188.0"'
	list remote 'us.sesame.canonical.com 36316'

