#!/bin/sh
# /etc/rc.local

BACKUP_URL="http://10.10.10.3:7070/backup-R2S.tar.gz"
HASH_FILE="/root/.backup-hash"
PENDING_FLAG="/root/.restore-pending"
PKG_LIST=/root/packages.list

logger -t config-restore "automated config restoration starting"

# 等网络就绪
for i in 1 2 3 4 5; do
    ping -c 1 -W 1 10.10.10.1 >/dev/null 2>&1 && break
    sleep 2
done

if [ -f "$PENDING_FLAG" ]; then
    # 恢复后重启：装缺失的包
    rm -f "$PENDING_FLAG"
    if [ -f "$PKG_LIST" ]; then
        logger -t config-restore "installing packages from $PKG_LIST"
        apk add $(cat "$PKG_LIST") 2>&1 | logger -t config-restore
    else
        logger -t config-restore "no packages.list found"
    fi
else
    # 正常启动：检查备份更新
    logger -t config-restore "downloading ${BACKUP_URL}"
    if curl -s -f -o /tmp/restore.tar.gz "$BACKUP_URL"; then
        NEW_HASH=$(md5sum /tmp/restore.tar.gz | cut -d' ' -f1)
        OLD_HASH=$(cat "$HASH_FILE" 2>/dev/null)
        logger -t config-restore "downloaded $(ls -l /tmp/restore.tar.gz | awk '{print $5}') bytes"
        if [ "$NEW_HASH" != "$OLD_HASH" ]; then
            logger -t config-restore "new backup detected, restoring..."
            sysupgrade -r /tmp/restore.tar.gz
            echo "$NEW_HASH" > "$HASH_FILE"
            touch "$PENDING_FLAG"
            logger -t config-restore "restore done, rebooting"
            reboot
        else
            logger -t config-restore "hash unchanged, skipping"
        fi
    else
        logger -t config-restore "download failed, skipping"
    fi
fi

exit 0
